{
  "name": "deepseek-mcp",
  "version": "0.2.0",
  "description": "DeepSeek V4 as a junior dev for Claude / Codex via MCP",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "mcpb validate manifest.json",
    "pack": "mcpb pack . dist/deepseek-mcp.mcpb",
    "release": "npm run typecheck && npm run build && npm run validate && npm run pack",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.1.0",
    "@types/node": "^22.19.17",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
